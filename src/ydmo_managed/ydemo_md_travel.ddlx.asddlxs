@Metadata.layer: #CUSTOMER
@Search.searchable: true
@UI:{
      headerInfo:{ typeName: 'Flight Travel',
                   typeNamePlural: 'Flight Travels',
                   title:{ value: 'TravelId' },
                   description:{ value: 'Description' }
                  }
     }
annotate entity YDEMO_C_TRAVEL with
{
  @UI:{ facet: [{ purpose: #STANDARD,id: 'Travel',position: 10, label: 'Travel',type: #IDENTIFICATION_REFERENCE }],

        identification: [{ label: 'Agency ID',position: 10, importance: #LOW },
                         { label: 'Cancel the Travel',position: 10, type: #FOR_ACTION, dataAction: 'Cancel' },
                         { label: 'Issue Message',position: 20, type: #FOR_ACTION, dataAction: 'IssueMessage' }],
        lineItem: [{ position: 10, label: 'Cancel the Travel', type: #FOR_ACTION, dataAction: 'Cancel' },
                   { position: 20, label: 'Issue Message', type: #FOR_ACTION, dataAction: 'IssueMessage' } ]
       }
  AgencyId;
  @UI: { identification: [ { position: 20, importance: #HIGH } ],
          selectionField: [ { position: 10  }]
        }
  TravelId;

  @UI: { lineItem:       [ { position: 20, importance: #HIGH } ],
         identification: [ { position: 30, importance: #HIGH } ]
       }
  @Search.defaultSearchElement: true
  Description;

  @UI: { lineItem:       [ { position: 30, importance: #MEDIUM } ],
         identification: [ { position: 40, importance: #MEDIUM } ],
         selectionField: [ { position: 20 }]
       }
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition: [ { entity: { name: '/DMO/I_Customer_StdVH', element: 'CustomerID' }, 
                                        additionalBinding: [{ localElement: 'CustomerId', element: 'CustomerID',usage: #FILTER_AND_RESULT }]  } ]
  CustomerId;

  @UI: { lineItem:       [ { position: 40, importance: #MEDIUM } ],
         identification: [ { position: 50, importance: #MEDIUM } ]
       }

  BeginDate;

  @UI: { lineItem:       [ { position: 50, importance: #LOW } ],
         identification: [ { position: 60, importance: #LOW } ]
       }
  EndDate;
  @UI: {
           lineItem:       [ { position: 55, importance: #LOW } ],
           identification: [ { position: 65, importance: #LOW } ]
         }
  Duration;

  @UI: { lineItem:       [ { position: 10, importance: #HIGH } ],
         identification: [ { position: 70, importance: #HIGH } ]
       }
  Status;

  //@Consumption.hidden: true
  //The field is not exposed for any consumption. This means that it is part of the OData Service and, therefore, not available on the UI.
  //@UI.hidden: true
  //The field is not available on the UI. This means that it is not displayed and the user cannot make it visible using personalization.
  //If, however, there is no additional annotation @Consumption.hidden: true, the field can still be part of the OData service.
  @UI: { identification: [ { position: 80, importance: #LOW } ]
      }
  ChangedAt;

  @UI: {identification: [ { position: 90, importance: #LOW } ]
      }
  ChangedBy;
  @UI: {identification: [ { position: 100, importance: #LOW } ]
      }
  LocChangedAt;
}