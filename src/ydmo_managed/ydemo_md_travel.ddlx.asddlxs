@Metadata.layer: #CUSTOMER
@Search.searchable: true
@UI:{
      headerInfo:{ typeName: 'Flight Travel',
                   typeNamePlural: 'Flight Travels',
                   title:{ value: 'TravelId' },
                   description:{ value: 'Description' }
                  }
     }
annotate entity YDEMO_C_TRAVEL with
{
  @UI:{ facet: [{ purpose: #STANDARD,id: 'Travel',position: 10, label: 'Travel',type: #IDENTIFICATION_REFERENCE }],
        identification: [{ label: 'Agency ID',position: 10, importance: #LOW }]
       }
  AgencyId;
  @UI: { identification: [ { position: 20, importance: #HIGH } ],
          selectionField: [ { position: 10  }]
        }
  TravelId;

  @UI: { lineItem:       [ { position: 20, importance: #HIGH } ],
         identification: [ { position: 30, importance: #HIGH } ]
       }
  @Search.defaultSearchElement: true
  Description;

  @UI: { lineItem:       [ { position: 30, importance: #MEDIUM } ],
         identification: [ { position: 40, importance: #MEDIUM } ],
         selectionField: [ { position: 20 }]
       }
  @Search.defaultSearchElement: true
  CustomerId;

  @UI: { lineItem:       [ { position: 40, importance: #MEDIUM } ],
         identification: [ { position: 50, importance: #MEDIUM } ]
       }

  BeginDate;

  @UI: { lineItem:       [ { position: 50, importance: #LOW } ],
         identification: [ { position: 60, importance: #LOW } ]
       }
  EndDate;

  @UI: { lineItem:       [ { position: 10, importance: #HIGH } ],
         identification: [ { position: 70, importance: #HIGH } ]
       }
  Status;

  @UI.hidden: true
  ChangedAt;

  @UI.hidden: true
  ChangedBy;

}