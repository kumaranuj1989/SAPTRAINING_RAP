managed implementation in class zbp_demo_r_travel unique;
strict ( 2 );

with draft;

define behavior for ydemo_R_TRAVEL alias Travel
persistent table ydemo_travel
draft table ydemo_d_travel
//In draft-enabled RAP BOs, it is mandatory to define a total ETag field.
lock master total etag ChangedAt
//Both global & Instance authorization can be made, it will create two methods
//
authorization master ( instance )
//You can consider the field that is annotated with @Semantics.systemDateTime.localInstanceLastChangedAt: true
//as a time stamp for the last change to the draft instance (“local Instance”). While the field annotated with @Semantics.systemdateTime.lastchangedAt: true
//contains the time stamp for the last change to the active instance.
etag master LocChangedAt  //ChangedAt

early numbering
{
  // ( Features: instance or features: global ) can be added to each of the below Actions
  // Precheck : A method is called before the update request to prevent unwanted changes from reaching the application buffer.
  //Internal : Prefix which disables the operation for external consumers of the BO.
  create ( authorization : global );
  //Global Feature Control is available for standard operations and custom actions but not at field level
  // where as instance feature control is available for all
  update ( features : instance );
  delete;
  //Static Field Control
  //Field(suppress) can be used to remove a field from the derived types, field mapping, and all RAP APIs.
  //It is possible for all fields except for key fields, foreign key fields, and fields used by the current behavior definition, such as ETag fields.
  // field ( readonly : update, mandatory : create ) AgencyId, TravelId;     commented for early numbering
  field ( readonly ) AgencyId, TravelId;
  field ( readonly ) ChangedAt, ChangedBy, Status, LocChangedAt, Duration;

  //field ( mandatory ) Description, CustomerId, BeginDate, EndDate;
  field ( mandatory ) Description, EndDate;
  field ( features : instance ) CustomerId, BeginDate;

  //Independent from Entity instance
  static action ( authorization : global ) issue_message;
  //Operates on Specific entity instance
  //Result parameter up to one data set
  //$self means the result parameter will have same result as entity
  //use keyword "parameter" to pass input to the action, the parameter will have the CDS abstract entity
  action ( features : instance ) cancel_travel result [1] $self;


  validation validateDescription on save { create; update; field Description; }

  validation validateCustomer on save { create; field CustomerId; }

  validation validateBeginDate on save { create; field BeginDate; }

  validation validateEndDate on save { create; field EndDate; }

  validation validateDateSequence on save { create; field BeginDate, EndDate; }
  // On modify(The determination is executed immediately after data changes take place) and
  determination determineStatus on modify { create; }
  //On Save(The determination is executed during the save sequence at the end of an transaction), it doesnt have failed parameter
  determination determineDuration on save { field BeginDate, EndDate; }


  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    //Only determinations defined with on save can be assigned.
    validation validateDescription;
    validation validateCustomer;
    validation validateBeginDate;
    validation validateEndDate;
    validation validateDateSequence;
  }

//below actions will be called using side effects
  determine action adjustDuration
  {
    validation validateBeginDate;
    validation validateEndDate;
    validation validateDateSequence;

    determination ( always ) determineDuration;
  }

  determine action checkCustomer
  {
   validation validateCustomer;
  }

  //This will call determine action checkcustomer and eventually it will call validate validate customer validation whenever customer ID is changed
  //This will be applicable for ODATA V4 only
  side effects { //determine action checkCustomer executed on field CustomerId affects messages;
  //This will call determine action adjustDuration and eventually it will call 3 validation defined whenever both field begin date and end date is changed
  //This will be applicable for ODATA V4 only. Note as 2 fields are mentioned, the methods will be called when both field are changed
                 determine action adjustDuration executed on field BeginDate, field EndDate affects field Duration, messages; }

  mapping for ydemo_travel corresponding
    {
      AgencyID     = agency_ID;
      TravelID     = travel_id;
      Description  = description;
      CustomerID   = customer_id;
      BeginDate    = begin_date;
      EndDate      = end_date;
      Status       = status;
      ChangedAt    = changed_at;
      ChangedBy    = changed_by;
      LocChangedAt = loc_changed_at;
    }
}