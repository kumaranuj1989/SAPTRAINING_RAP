projection;
strict ( 2 );
use draft;
use side effects;
define behavior for YDEMO_C_TRAVEL alias TravelP
use etag
{
  use create;
  use update;
  use delete;
  //Alias and External to be used in metadata for dataAction
  //you can use Alias and external for the same action as well
  use action cancel_travel as Cancel;
  use action issue_message external 'IssueMessage';

  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;

  use action adjustDuration;
  use action checkCustomer;
}