projection;
strict ( 2 );
use draft;
define behavior for YDMO_C_TRAVEL alias TravelP
use etag
{
  use create;
  use update;
  use delete;

  use association _TravelItem { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;
}

define behavior for YDMO_C_TRAVELITEM alias TravelItemP
use etag
{
  use update;
  use delete;

  use association _Travel { with draft; }
}