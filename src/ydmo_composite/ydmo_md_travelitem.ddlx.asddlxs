@Metadata.layer: #CUSTOMER
@UI: {
   headerInfo: {
     typeName: 'Flight Travel Item',
     typeNamePlural: 'Flight Travel Items'
               }
     }
annotate entity YDMO_C_TRAVELITEM with
{

  @UI.facet: [ { id:            'Booking',
                purpose:       #STANDARD,
                type:          #IDENTIFICATION_REFERENCE,
                label:         'Travel Item',
                position:      10 } ]

  @UI.hidden: true
  ItemUuid;

  @UI: { identification: [ { position: 10, importance: #LOW } ] }
  AgencyId;
  @UI: { identification: [ { position: 20, importance: #LOW } ]}
  TravelId;
  @UI: { lineItem:       [ { position: 30, importance: #HIGH } ],
          identification: [ { position: 30, importance: #HIGH } ] }
  @Consumption.valueHelpDefinition: [ { entity: { name:    '/DMO/I_Carrier_StdVH', element: 'AirlineID' } } ]
  CarrierId;
  @UI: { lineItem:       [ { position: 40, importance: #HIGH } ],
          identification: [ { position: 40, importance: #HIGH } ] }
  @Consumption.valueHelpDefinition: [ { entity: { name:    '/DMO/I_Connection_StdVH', element: 'ConnectionID' },
                                       additionalBinding: [ { localElement: 'CarrierId', element: 'AirlineID', usage: #FILTER_AND_RESULT } ],
                                       label: 'Value Help by Connection' },
                                     { entity: { name:    '/DMO/I_Flight_StdVH',  element: 'ConnectionID' },
                                       additionalBinding: [ { localElement: 'CarrierId', element: 'AirlineID', usage: #FILTER_AND_RESULT },
                                                            { localElement: 'FlightDate',  element: 'FlightDate', usage: #RESULT } ],
                                       label: 'Value Help by Flight',
                                       qualifier: 'Secondary Value help'  } ]
  ConnectionId;
  @UI: {
          lineItem:       [ { position: 50, importance: #HIGH } ],
          identification: [ { position: 50, importance: #HIGH } ]
        }
  @Consumption.valueHelpDefinition:  [ { entity: { name:    '/DMO/I_Flight_StdVH', element: 'FlightDate'  },
                                         additionalBinding: [ { localElement: 'CarrierId', element:      'AirlineID', usage:         #FILTER_AND_RESULT },
                                                              { localElement: 'ConnectionId', element:      'ConnectionID', usage:        #RESULT } ] } ]
  FlightDate;
  @UI: {
          lineItem:       [ { position: 60, importance: #HIGH } ],
          identification: [ { position: 60, importance: #HIGH } ]
        }
  BookingId;
  @UI: {
          lineItem:       [ { position: 20, importance: #HIGH } ],
          identification: [ { position: 70, importance: #MEDIUM } ]
       }
  PassengerFirstName;
  @UI: {
          lineItem:       [ { position: 10, importance: #HIGH } ],
          identification: [ { position: 80, importance: #MEDIUM } ]
       }
  PassengerLastName;

  @UI: { identification: [ { position: 90, importance: #LOW } ]
      }
  ChangedAt;
  @UI: { identification: [ { position: 100, importance: #LOW } ]
      }
  ChangedBy;
  @UI: { identification: [ { position: 110, importance: #LOW } ]
      }
  LocChangedAt;



}